# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=supersecretjwtkey_nexvia_2026_enterprise

# Marketplace Platform Fee (10% Platform, 90% Vendor Payout)
PLATFORM_COMMISSION_PERCENT=10

# 1. MongoDB Database URI (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexvia_marketplace

# 2. Razorpay Payment Gateway (Test or Live Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# 3. AWS S3 Storage (For Product Photos)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name

# 4. Redis Cache (Optional - Local or Upstash Redis URL)
REDIS_URL=redis://127.0.0.1:6379
