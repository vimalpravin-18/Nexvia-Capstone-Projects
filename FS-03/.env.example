# Nexvia Technologies — FS-03 Root Environment Variable Template
# Copy this file to backend/.env and customize with your credentials.

# -------------------------------------------------------------
# 1. API SERVER & SECURITY
# -------------------------------------------------------------
PORT=5001
JWT_SECRET=nexvia_lms_super_secret_jwt_key_2026_enterprise

# -------------------------------------------------------------
# 2. PERSISTENCE & DATABASE
# -------------------------------------------------------------
# MongoDB Atlas Connection URI (isolated database 'nexvia_lms')
# Leave commented out to run with zero-config resilient local store:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexvia_lms

# -------------------------------------------------------------
# 3. BACKGROUND JOBS & CACHING (BullMQ + Redis)
# -------------------------------------------------------------
# Redis URL for background media processing and queues:
REDIS_URL=redis://127.0.0.1:6379

# -------------------------------------------------------------
# 4. AWS S3 & CLOUDFRONT CDN MEDIA DELIVERY
# -------------------------------------------------------------
AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=nexvia-lms-media-assets
# CLOUDFRONT_DOMAIN=d123456abcdef8.cloudfront.net
